# systemd unit template. deploy/install.sh fills in @USER@ and @APP_DIR@
# and installs the result to /etc/systemd/system/my-todo-app.service.
[Unit]
Description=my-todo-app (FastAPI to-do app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
# The database lives outside the git checkout so deploys never touch it.
# StateDirectory creates /var/lib/my-todo-app owned by @USER@.
StateDirectory=my-todo-app
Environment=TODO_DB_PATH=/var/lib/my-todo-app/todos.db
ExecStart=@APP_DIR@/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port @PORT@
Restart=on-failure
RestartSec=3

# Hardening that doesn't interfere with an app running from a home directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
